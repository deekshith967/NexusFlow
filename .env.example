# NexusFlow environment configuration
# Copy to .env (or export in your shell) and adjust. No secret values are
# required for local development.

# --- Required ----------------------------------------------------------------
# PostgreSQL connection string (authoritative store).
DATABASE_URL=postgres://user:password@127.0.0.1:5432/nexusflow

# PostgreSQL TLS. 'true'/'false' wins when set; when unset, TLS is
# auto-detected from sslmode/ssl parameters in DATABASE_URL.
# - Render INTERNAL URL (render.yaml fromDatabase): leave UNSET. The
#   private network does not require TLS, and forcing TLS crashes
#   startup when the server does not offer it (no plaintext fallback).
# - Render EXTERNAL URL or other TLS-mandating providers: set 'true'
#   (or use ?sslmode=require in the URL), otherwise startup fails.
DATABASE_SSL=

# --- API authentication (required for the api/all roles) ------------------------
# Comma-separated name:secret:tenant-UUID entries. Each key binds its
# bearer to exactly one tenant server-side; requests authenticate with
#   Authorization: Bearer <secret>
# Secrets must be >= 16 characters, unique per key, must not contain
# ':' or ',' (entry separators), and must never be committed.
# Generate with: openssl rand -hex 24
# Example (fake values — generate your own):
# NEXUSFLOW_API_KEYS=tenant-a-key:9f2c4e...truncated...:11111111-1111-4111-8111-111111111111
NEXUSFLOW_API_KEYS=

# --- Roles --------------------------------------------------------------------
# One process per role in production deployments:
#   api | scheduler | worker | outbox-relay | all
# 'all' runs everything in one process (local demo convenience only).
# The HTTP API is served by the api and all roles.
NEXUSFLOW_ROLE=all

# HTTP port for the api/all roles.
PORT=3000

# --- Transport ------------------------------------------------------------------
# 'kafka'    : production transport (requires a reachable Kafka broker)
# 'memory'   : in-process transport for tests and single-process local demos
#              (NOT a substitute for Kafka in a multi-process deployment;
#              the worker and outbox-relay roles reject memory explicitly)
NEXUSFLOW_TRANSPORT=memory

# Kafka settings (used only when NEXUSFLOW_TRANSPORT=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NEXUSFLOW_DISPATCH_TOPIC=nexusflow.task.dispatch
NEXUSFLOW_LIFECYCLE_TOPIC=nexusflow.workflow.events
NEXUSFLOW_WORKER_GROUP=nexusflow-workers

# Kafka transport security. Local plaintext brokers: leave all unset.
# Managed brokers require TLS + SASL (all three named options use SASL_SSL):
#   Confluent Cloud: KAFKA_SASL_MECHANISM=plain (+ API key as username/secret)
#   Upstash / Redpanda: KAFKA_SASL_MECHANISM=scram-sha-256 (or scram-sha-512)
# SASL requires KAFKA_SSL=true (credentials never travel over plaintext).
KAFKA_SSL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Multi-tenancy ----------------------------------------------------------------
# Informational default tenant (UUID), echoed in /health/ready. API
# identity comes from NEXUSFLOW_API_KEYS (the key's tenant always
# wins); the X-Tenant-Id header must match it when present.
NEXUSFLOW_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Tuning (optional; defaults shown) ---------------------------------------------
NEXUSFLOW_SERVICE_ID=
SCHEDULER_POLL_MS=250
SCHEDULER_BATCH_LIMIT=20
NEXUSFLOW_LEASE_MS=30000
RELAY_POLL_MS=250
RELAY_BATCH_LIMIT=20
RELAY_CLAIM_TTL_MS=30000
# Bounded wait for one broker publish. Slower than this => recorded
# failure + claim released + retried (also bounds the shutdown drain).
RELAY_PUBLISH_TIMEOUT_MS=30000
