# NexusFlow environment configuration
# Copy to .env (or export in your shell) and adjust. No secret values are
# required for local development.

# --- Required ----------------------------------------------------------------
# PostgreSQL connection string (authoritative store).
DATABASE_URL=postgres://user:password@127.0.0.1:5432/nexusflow

# --- Roles --------------------------------------------------------------------
# One process per role in production deployments:
#   api | scheduler | worker | outbox-relay | all
# 'all' runs everything in one process (local demo convenience only).
# The HTTP API is served by the api and all roles.
NEXUSFLOW_ROLE=all

# HTTP port for the api/all roles.
PORT=3000

# --- Transport ------------------------------------------------------------------
# 'kafka'    : production transport (requires a reachable Kafka broker)
# 'memory'   : in-process transport for tests and single-process local demos
#              (NOT a substitute for Kafka in a multi-process deployment;
#              NEXUSFLOW_ROLE=worker rejects memory explicitly)
NEXUSFLOW_TRANSPORT=memory

# Kafka settings (used only when NEXUSFLOW_TRANSPORT=kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NEXUSFLOW_DISPATCH_TOPIC=nexusflow.task.dispatch
NEXUSFLOW_LIFECYCLE_TOPIC=nexusflow.workflow.events
NEXUSFLOW_WORKER_GROUP=nexusflow-workers

# --- Multi-tenancy ----------------------------------------------------------------
# Default tenant (UUID) used when a request omits the X-Tenant-Id header.
NEXUSFLOW_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Tuning (optional; defaults shown) ---------------------------------------------
NEXUSFLOW_SERVICE_ID=
SCHEDULER_POLL_MS=250
SCHEDULER_BATCH_LIMIT=20
NEXUSFLOW_LEASE_MS=30000
RELAY_POLL_MS=250
RELAY_BATCH_LIMIT=20
RELAY_CLAIM_TTL_MS=30000
